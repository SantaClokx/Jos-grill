{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/admin.js": { "maxDuration": 15 },
    "api/menu.js": { "maxDuration": 15 },
    "api/orders.js": { "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/api/admin", "destination": "/api/admin.js" },
    { "source": "/api/menu", "destination": "/api/menu.js" },
    { "source": "/api/orders", "destination": "/api/orders.js" }
  ]
}
